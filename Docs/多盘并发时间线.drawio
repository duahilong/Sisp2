<mxfile host="app.diagrams.net" agent="pi"><diagram id="timeline" name="多盘流水时间线"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="620" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="多盘安装流水线：分区串行 + 镜像交错（3 块盘，单盘 分区40s / 镜像300s / 引导10s）" style="text;html=0;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1120" height="26" as="geometry"/></mxCell><mxCell id="axis" value="" style="endArrow=none;html=0;strokeColor=#666;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="78" as="sourcePoint"/><mxPoint x="1010" y="78" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r1" value="磁盘 1" style="text;html=0;fontSize=12;align=right;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="16" y="106" width="96" height="28" as="geometry"/></mxCell><mxCell id="r2" value="磁盘 2" style="text;html=0;fontSize=12;align=right;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="16" y="156" width="96" height="28" as="geometry"/></mxCell><mxCell id="r3" value="磁盘 3" style="text;html=0;fontSize=12;align=right;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="16" y="206" width="96" height="28" as="geometry"/></mxCell><mxCell id="p1" value="分区 + 验收" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="120" y="108" width="80" height="24" as="geometry"/></mxCell><mxCell id="g1" value="Ghost 写镜像（300s）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="200" y="108" width="600" height="24" as="geometry"/></mxCell><mxCell id="b1" value="引导" style="rounded=0;whiteSpace=wrap;html=0;fontSize=9;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="800" y="108" width="26" height="24" as="geometry"/></mxCell><mxCell id="w2" value="排队等分区" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontColor=#7F7F7F;" vertex="1" parent="1"><mxGeometry x="120" y="158" width="80" height="24" as="geometry"/></mxCell><mxCell id="p2" value="分区 + 验收" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="200" y="158" width="80" height="24" as="geometry"/></mxCell><mxCell id="g2" value="Ghost 写镜像（300s）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="280" y="158" width="600" height="24" as="geometry"/></mxCell><mxCell id="b2" value="引导" style="rounded=0;whiteSpace=wrap;html=0;fontSize=9;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="880" y="158" width="26" height="24" as="geometry"/></mxCell><mxCell id="w3" value="排队等分区" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontColor=#7F7F7F;" vertex="1" parent="1"><mxGeometry x="120" y="208" width="160" height="24" as="geometry"/></mxCell><mxCell id="p3" value="分区 + 验收" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="280" y="208" width="80" height="24" as="geometry"/></mxCell><mxCell id="g3" value="Ghost 写镜像（300s）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="360" y="208" width="600" height="24" as="geometry"/></mxCell><mxCell id="b3" value="引导" style="rounded=0;whiteSpace=wrap;html=0;fontSize=9;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="960" y="208" width="26" height="24" as="geometry"/></mxCell><mxCell id="l40" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="70" as="sourcePoint"/><mxPoint x="200" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l80" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="70" as="sourcePoint"/><mxPoint x="280" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l120" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="70" as="sourcePoint"/><mxPoint x="360" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l340" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="70" as="sourcePoint"/><mxPoint x="800" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l430" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#C0392B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="984" y="70" as="sourcePoint"/><mxPoint x="984" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n1" value="t=40s：磁盘1 分区+验收完成 → ①磁盘1 立刻启动 Ghost；②磁盘2 开始分区" style="text;html=0;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#2E5C2E;" vertex="1" parent="1"><mxGeometry x="206" y="86" width="330" height="18" as="geometry"/></mxCell><mxCell id="n2" value="t=80s：磁盘2 分区完成 → 磁盘2 启动 Ghost；磁盘3 开始分区" style="text;html=0;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#2E5C2E;" vertex="1" parent="1"><mxGeometry x="286" y="240" width="330" height="18" as="geometry"/></mxCell><mxCell id="n3" value="同一时刻只有一块盘在「分区/验收」（PartitionSequencer 串行），Ghost 与引导可以同时跑" style="text;html=0;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="272" width="760" height="18" as="geometry"/></mxCell><mxCell id="n4" value="Ghost 启动间隔 = 上一块盘之后的「分区+验收」时长（这里 40s），远大于 2.5s 启动闸门；不会同时启动" style="text;html=0;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="294" width="800" height="18" as="geometry"/></mxCell><mxCell id="sum" value="总耗时：t=430s 全部完成（最后一块盘 Ghost 420s 结束 + 引导 10s）&#xa;对比全串行 3 × 350s = 1050s，约 2.4 倍提速" style="rounded=1;whiteSpace=wrap;html=0;fontSize=12;align=left;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="326" width="440" height="52" as="geometry"/></mxCell><mxCell id="cls1" value="分区/验收" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="20" y="398" width="90" height="20" as="geometry"/></mxCell><mxCell id="cls2" value="Ghost 镜像" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="118" y="398" width="90" height="20" as="geometry"/></mxCell><mxCell id="cls3" value="UEFI 引导+校验" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="216" y="398" width="120" height="20" as="geometry"/></mxCell><mxCell id="cls4" value="排队等待（线程在跑，尚未分区）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;" vertex="1" parent="1"><mxGeometry x="344" y="398" width="220" height="20" as="geometry"/></mxCell><mxCell id="fail" value="失败/取消语义：某盘分区验收失败 → 该盘 Ghost 记「未执行」，后续盘照常分区；取消 → 排队中的盘直接标记「任务已取消（排队中）」，正在分区的盘在步骤边界停下" style="text;html=0;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#8A4B08;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="960" height="18" as="geometry"/></mxCell><mxCell id="axis0" value="0s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="110" y="58" width="20" height="16" as="geometry"/></mxCell><mxCell id="axis40" value="40s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="190" y="58" width="20" height="16" as="geometry"/></mxCell><mxCell id="axis80" value="80s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="270" y="58" width="20" height="16" as="geometry"/></mxCell><mxCell id="axis120" value="120s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="350" y="58" width="20" height="16" as="geometry"/></mxCell><mxCell id="axis340" value="340s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="790" y="58" width="20" height="16" as="geometry"/></mxCell><mxCell id="axis430" value="430s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="972" y="58" width="20" height="16" as="geometry"/></mxCell></mxGraphModel></diagram><diagram id="seq" name="机制时序"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="760" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="st" value="机制时序：确认 → 分派 → 分区闸门 → 镜像并发" style="text;html=0;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="900" height="26" as="geometry"/></mxCell><mxCell id="a1" value="WorkflowController" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="140" height="30" as="geometry"/></mxCell><mxCell id="a2" value="JobManager" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="290" y="52" width="130" height="30" as="geometry"/></mxCell><mxCell id="a3" value="磁盘1 线程" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="500" y="52" width="120" height="30" as="geometry"/></mxCell><mxCell id="a4" value="磁盘2 线程" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="680" y="52" width="120" height="30" as="geometry"/></mxCell><mxCell id="a5" value="PartitionSequencer" style="rounded=0;whiteSpace=wrap;html=0;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="880" y="52" width="150" height="30" as="geometry"/></mxCell><mxCell id="lf1" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="82" as="sourcePoint"/><mxPoint x="110" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lf2" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="82" as="sourcePoint"/><mxPoint x="355" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lf3" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="82" as="sourcePoint"/><mxPoint x="560" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lf4" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="82" as="sourcePoint"/><mxPoint x="740" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lf5" value="" style="endArrow=none;html=0;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="955" y="82" as="sourcePoint"/><mxPoint x="955" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m1" value="confirm(job_ids) → set_order([1,2]) → confirm_batch(max_parallel=2)" style="endArrow=block;html=0;fontSize=10;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="108" as="sourcePoint"/><mxPoint x="355" y="108" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2" value="起 2 个线程（Semaphore(2)）" style="endArrow=block;html=0;fontSize=10;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="136" as="sourcePoint"/><mxPoint x="560" y="136" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3" value="同时起线程" style="endArrow=block;html=0;fontSize=10;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="164" as="sourcePoint"/><mxPoint x="740" y="164" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4" value="enter(1)" style="endArrow=block;html=0;fontSize=10;strokeColor=#82B366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="192" as="sourcePoint"/><mxPoint x="955" y="192" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" value="enter(2) → 阻塞（head=1）" style="endArrow=block;html=0;fontSize=10;strokeColor=#C0392B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="220" as="sourcePoint"/><mxPoint x="955" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6" value="分区 + 布局验收（约 40s）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="380" y="246" width="220" height="24" as="geometry"/></mxCell><mxCell id="m7" value="done(1) → notify_all" style="endArrow=block;html=0;fontSize=10;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="298" as="sourcePoint"/><mxPoint x="955" y="298" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8" value="enter(2) 返回 True" style="endArrow=block;html=0;fontSize=10;strokeColor=#82B366;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="326" as="sourcePoint"/><mxPoint x="900" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9" value="Ghost 启动（start_gate ≥2.5s）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="352" width="240" height="24" as="geometry"/></mxCell><mxCell id="m10" value="分区 + 验收（接续执行）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="700" y="352" width="200" height="24" as="geometry"/></mxCell><mxCell id="m11" value="Ghost 1 仍在写镜像（300s）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="404" width="240" height="24" as="geometry"/></mxCell><mxCell id="m12" value="done(2) → 无后续盘，直接放行" style="endArrow=block;html=0;fontSize=10;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="456" as="sourcePoint"/><mxPoint x="955" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13" value="bcdboot + 校验（约 10s）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="220" height="24" as="geometry"/></mxCell><mxCell id="m14" value="Ghost 2 启动（等启动闸门，距 Ghost 1 已 40s）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="700" y="480" width="300" height="24" as="geometry"/></mxCell><mxCell id="m15" value="任务 1 → OK（分区/镜像/引导 全部 ok）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=middle;fillColor=#F8F8F8;strokeColor=#B3B3B3;" vertex="1" parent="1"><mxGeometry x="380" y="532" width="260" height="24" as="geometry"/></mxCell><mxCell id="m16" value="任务 2 → OK（晚 40s 开始，仍在跑）" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;align=left;verticalAlign=middle;fillColor=#F8F8F8;strokeColor=#B3B3B3;" vertex="1" parent="1"><mxGeometry x="700" y="532" width="260" height="24" as="geometry"/></mxCell><mxCell id="note" value="关键：分区组是「准入闸门」，不是「等待上一盘 ghost 成功」。磁盘1 一离开闸门就启动 Ghost，磁盘2 同时获得闸门 → 两者的 Ghost 重叠，但启动时刻相差一个分区时长。" style="rounded=1;whiteSpace=wrap;html=0;fontSize=11;align=left;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="960" height="48" as="geometry"/></mxCell></mxGraphModel></diagram><diagram id="six" name="6盘时间线"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="600" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t6" value="6 块盘流水线：分区全局串行 + 镜像交错（单盘 分区/验收 40s、Ghost 300s、引导 10s）" style="text;html=0;fontSize=15;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1260" height="26" as="geometry"/></mxCell><mxCell id="sub6" value="总耗时 t=550s；全串行需 6 × 350s = 2100s，约 3.8 倍提速" style="text;html=0;fontSize=12;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#2E5C2E;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="900" height="18" as="geometry"/></mxCell><mxCell id="ax6" value="" style="endArrow=none;html=0;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="78" as="sourcePoint"/><mxPoint x="1230" y="78" as="targetPoint"/></mxGeometry></mxCell><mxCell id="tk0" value="0s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="106" y="58" width="28" height="16" as="geometry"/></mxCell><mxCell id="tk100" value="100s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="306" y="58" width="28" height="16" as="geometry"/></mxCell><mxCell id="tk200" value="200s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="506" y="58" width="28" height="16" as="geometry"/></mxCell><mxCell id="tk300" value="300s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="706" y="58" width="28" height="16" as="geometry"/></mxCell><mxCell id="tk400" value="400s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="906" y="58" width="28" height="16" as="geometry"/></mxCell><mxCell id="tk500" value="500s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1106" y="58" width="28" height="16" as="geometry"/></mxCell><mxCell id="tk550" value="550s" style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1206" y="58" width="28" height="16" as="geometry"/></mx